{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": [
      "es2022"
    ],
    "types": [],
    "strict": true,
    "declaration": true,
    "stripInternal": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src"
  ]
}
