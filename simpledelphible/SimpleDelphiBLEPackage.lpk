<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="SimpleDelphiBLEPackage"/>
    <Type Value="RunTimeOnly"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="source"/>
        <OtherUnitFiles Value="source"/>
        <UnitOutputDirectory Value="units/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="DelphiUnicode"/>
        </SyntaxOptions>
      </Parsing>
      <Conditionals Value="// Programs link with libsimplecble on macOS and Linux, so they get the library folder for their target.
if TargetOS = &apos;darwin&apos; then begin
  if TargetCPU = &apos;aarch64&apos; then
    UsageLibraryPath := &apos;lib/macos-arm64&apos;
  else
    UsageLibraryPath := &apos;lib/macos-x64&apos;;
end else if TargetOS = &apos;linux&apos; then begin
  if TargetCPU = &apos;aarch64&apos; then
    UsageLibraryPath := &apos;lib/linux-arm64&apos;
  else
    UsageLibraryPath := &apos;lib/linux-x64&apos;;
end;"/>
    </CompilerOptions>
    <Description Value="SimpleBLE for Delphi and Free Pascal: Bluetooth Low Energy on Windows, macOS, and Linux."/>
    <License Value="Business Source License 1.1 (BUSL-1.1)"/>
    <Files Count="11">
      <Item1>
        <Filename Value="source/SimpleDelphiBLE.pas"/>
        <UnitName Value="SimpleDelphiBLE"/>
      </Item1>
      <Item2>
        <Filename Value="source/SimpleDelphiBLE.Native.pas"/>
        <UnitName Value="SimpleDelphiBLE.Native"/>
      </Item2>
      <Item3>
        <Filename Value="source/SimpleDelphiBLE.inc"/>
        <Type Value="Include"/>
      </Item3>
      <Item4>
        <Filename Value="source/SimpleDelphiBLE.Support.inc"/>
        <Type Value="Include"/>
      </Item4>
      <Item5>
        <Filename Value="source/SimpleDelphiBLE.Events.inc"/>
        <Type Value="Include"/>
      </Item5>
      <Item6>
        <Filename Value="source/SimpleDelphiBLE.Callbacks.inc"/>
        <Type Value="Include"/>
      </Item6>
      <Item7>
        <Filename Value="source/SimpleDelphiBLE.Backend.inc"/>
        <Type Value="Include"/>
      </Item7>
      <Item8>
        <Filename Value="source/SimpleDelphiBLE.Adapter.inc"/>
        <Type Value="Include"/>
      </Item8>
      <Item9>
        <Filename Value="source/SimpleDelphiBLE.Peripheral.inc"/>
        <Type Value="Include"/>
      </Item9>
      <Item10>
        <Filename Value="source/SimpleDelphiBLE.LocalPeripheral.inc"/>
        <Type Value="Include"/>
      </Item10>
      <Item11>
        <Filename Value="source/SimpleDelphiBLE.Config.inc"/>
        <Type Value="Include"/>
      </Item11>
    </Files>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
