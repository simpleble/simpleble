<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SimpleSharpBLEScan</RootNamespace>
    <ApplicationId>org.simpleble.simplesharpble.scan</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../simplesharpble/SimpleSharpBLE.csproj" />
    <AndroidJavaSource Include="../../simpledroidbridge/src/main/java/org/simpleble/android/bridge/*.java" Bind="false" />
    <ProguardConfiguration Include="../../simplesharpble/buildTransitive/android/proguard.cfg" />
    <AndroidNativeLibrary Include="$(NativeLibrariesDirectory)/android-arm64/native/*.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(NativeLibrariesDirectory)/android-x64/native/*.so" Abi="x86_64" />
    <AndroidResource Include="../simpleble-android/app/src/main/res/drawable-nodpi/simpleble_logo.png" Link="Resources/drawable-nodpi/simpleble_logo.png" />
    <AndroidResource Include="../simpleble-android/app/src/main/res/drawable-night-nodpi/simpleble_logo.png" Link="Resources/drawable-night-nodpi/simpleble_logo.png" />
  </ItemGroup>
</Project>
