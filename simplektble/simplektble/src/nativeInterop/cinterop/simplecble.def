headers = simplecble/simplecble.h simplektble/identity.h
headerFilter = simplecble/* simplecble/local/* simplektble/*
staticLibraries = libsimplektble-apple.a libsimplecble.a libsimpleble.a
linkerOpts.ios = -lc++ -lobjc -framework Foundation -framework CoreBluetooth
linkerOpts.osx = -lc++ -lobjc -framework Foundation -framework CoreBluetooth -framework IOBluetooth -framework IOKit
