<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <!-- Apple mobile runtime assets import symbols from the statically linked app. -->
    <DefineConstants Condition="'$(SimpleSharpBLEStaticLink)' == 'true'">$(DefineConstants);SIMPLESHARPBLE_STATIC</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</Version>
    <PackageVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-dev([0-9]+)$', '-dev.$1'))</PackageVersion>
    <_NativeLibraryMajorVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^[0-9]+').Value)</_NativeLibraryMajorVersion>
    <Description>.NET bindings for SimpleBLE.</Description>
    <IsPackable>true</IsPackable>
    <PackageId Condition="'$(PackageId)' == ''">SimpleSharpBLE</PackageId>
    <Authors>The California Open Source Company</Authors>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/simpleble/simpleble</RepositoryUrl>
    <PackageTags>bluetooth;ble;simpleble</PackageTags>
    <_NativeRuntimeIdentifier>$(RuntimeIdentifier)</_NativeRuntimeIdentifier>
    <_NativeRuntimeIdentifier Condition="'$(_NativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_NativeRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Compile Remove="src/Compatibility/IsExternalInit.cs" Condition="'$(TargetFramework)' != 'netstandard2.1'" />
    <InternalsVisibleTo Include="SimpleSharpBLE.Tests" />
    <None Include="../LICENSE.md" Pack="true" PackagePath="/LICENSE.md" />
    <None Update="README.md" Pack="true" PackagePath="/README.md" />
    <None Update="buildTransitive/SimpleSharpBLE.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Update="buildTransitive/android/proguard.cfg" Pack="true" PackagePath="buildTransitive/android/proguard.cfg" />
    <None Include="../simpledroidbridge/src/main/java/org/simpleble/android/bridge/*.java" Pack="true" PackagePath="buildTransitive/android/bridge/" />
    <None Include="$(NativeLibrariesDirectory)/**/*.dll" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(NativeLibrariesDirectory)' != ''" />
    <None Include="$(NativeLibrariesDirectory)/**/*.dylib" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(NativeLibrariesDirectory)' != ''" />
    <None Include="$(NativeLibrariesDirectory)/**/*.so*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(NativeLibrariesDirectory)' != ''" />
    <!-- Static archives are link inputs, not files to copy into the app bundle. -->
    <None Include="$(NativeLibrariesDirectory)/**/*.a" Pack="true" PackagePath="buildTransitive/apple/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(NativeLibrariesDirectory)' != ''" />
    <None Include="$(NativeLibraryDirectory)/simplecble.dll;$(NativeLibraryDirectory)/simpleble.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/$(_NativeRuntimeIdentifier)/native/" Condition="'$(NativeLibraryDirectory)' != '' And $(_NativeRuntimeIdentifier.StartsWith('win-'))" />
    <None Include="$(NativeLibraryDirectory)/libsimpleble*.dylib;$(NativeLibraryDirectory)/libsimplecble*.dylib" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/osx-arm64/native/" Condition="'$(NativeLibraryDirectory)' != '' And '$(_NativeRuntimeIdentifier)' == 'osx-arm64'" />
    <None Include="$(NativeLibraryDirectory)/libsimpleble.so*;$(NativeLibraryDirectory)/libsimplecble.so*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="runtimes/$(_NativeRuntimeIdentifier)/native/" Condition="'$(NativeLibraryDirectory)' != '' And ('$(_NativeRuntimeIdentifier)' == 'linux-x64' Or '$(_NativeRuntimeIdentifier)' == 'linux-arm64' Or '$(_NativeRuntimeIdentifier)' == 'android-arm64' Or '$(_NativeRuntimeIdentifier)' == 'android-x64')" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeLibrariesDirectory)' != ''">
    <_AppleRuntime Include="ios-arm64;iossimulator-arm64;maccatalyst-arm64" Condition="'$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain'" />
    <_AppleRuntime Include="$(RuntimeIdentifier)" Condition="'$(RuntimeIdentifier)' == 'ios-arm64' Or '$(RuntimeIdentifier)' == 'iossimulator-arm64' Or '$(RuntimeIdentifier)' == 'maccatalyst-arm64'" />
    <RequiredNativeLibrary Include="@(_AppleRuntime->'$(NativeLibrariesDirectory)/%(Identity)/native/libsimpleble.a');@(_AppleRuntime->'$(NativeLibrariesDirectory)/%(Identity)/native/libsimplecble.a');@(_AppleRuntime->'$(NativeLibrariesDirectory)/%(Identity)/lib/net10.0/SimpleSharpBLE.dll')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/win-x64/native/simpleble.dll;$(NativeLibrariesDirectory)/win-x64/native/simplecble.dll" Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'win-x64'" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/win-arm64/native/simpleble.dll;$(NativeLibrariesDirectory)/win-arm64/native/simplecble.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/osx-arm64/native/libsimpleble.dylib;$(NativeLibrariesDirectory)/osx-arm64/native/libsimplecble.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/linux-x64/native/libsimpleble.so;$(NativeLibrariesDirectory)/linux-x64/native/libsimpleble.so.$(_NativeLibraryMajorVersion);$(NativeLibrariesDirectory)/linux-x64/native/libsimplecble.so;$(NativeLibrariesDirectory)/linux-x64/native/libsimplecble.so.$(_NativeLibraryMajorVersion)" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/linux-arm64/native/libsimpleble.so;$(NativeLibrariesDirectory)/linux-arm64/native/libsimpleble.so.$(_NativeLibraryMajorVersion);$(NativeLibrariesDirectory)/linux-arm64/native/libsimplecble.so;$(NativeLibrariesDirectory)/linux-arm64/native/libsimplecble.so.$(_NativeLibraryMajorVersion)" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/android-arm64/native/libsimpleble.so;$(NativeLibrariesDirectory)/android-arm64/native/libsimplecble.so" Condition="'$(RuntimeIdentifier)' == 'android-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
    <RequiredNativeLibrary Include="$(NativeLibrariesDirectory)/android-x64/native/libsimpleble.so;$(NativeLibrariesDirectory)/android-x64/native/libsimplecble.so" Condition="'$(RuntimeIdentifier)' == 'android-x64' Or ('$(RuntimeIdentifier)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain')" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeLibrariesDirectory)' == '' And '$(NativeLibraryDirectory)' != ''">
    <RequiredNativeLibrary Include="$(NativeLibraryDirectory)/simpleble.dll;$(NativeLibraryDirectory)/simplecble.dll" Condition="$(_NativeRuntimeIdentifier.StartsWith('win-'))" />
    <RequiredNativeLibrary Include="$(NativeLibraryDirectory)/libsimpleble.dylib;$(NativeLibraryDirectory)/libsimplecble.dylib" Condition="'$(_NativeRuntimeIdentifier)' == 'osx-arm64'" />
    <RequiredNativeLibrary Include="$(NativeLibraryDirectory)/libsimpleble.so;$(NativeLibraryDirectory)/libsimpleble.so.$(_NativeLibraryMajorVersion);$(NativeLibraryDirectory)/libsimplecble.so;$(NativeLibraryDirectory)/libsimplecble.so.$(_NativeLibraryMajorVersion)" Condition="'$(_NativeRuntimeIdentifier)' == 'linux-x64' Or '$(_NativeRuntimeIdentifier)' == 'linux-arm64'" />
    <RequiredNativeLibrary Include="$(NativeLibraryDirectory)/libsimpleble.so;$(NativeLibraryDirectory)/libsimplecble.so" Condition="'$(_NativeRuntimeIdentifier)' == 'android-arm64' Or '$(_NativeRuntimeIdentifier)' == 'android-x64'" />
  </ItemGroup>
  <Target Name="RequireNativeLibraries" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(NativeLibrariesDirectory)' == '' And '$(PackageId)' != 'SimpleSharpBLE.Plain'"
           Text="Set NativeLibrariesDirectory to the staged runtime assets directory, or select one platform with RuntimeIdentifier." />
    <Error Condition="'$(NativeLibrariesDirectory)' != '' And '$(NativeLibraryDirectory)' != ''"
           Text="Specify either NativeLibrariesDirectory or NativeLibraryDirectory." />
    <Error Condition="'$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'win-x64' And '$(RuntimeIdentifier)' != 'win-arm64' And '$(RuntimeIdentifier)' != 'osx-arm64' And '$(RuntimeIdentifier)' != 'linux-x64' And '$(RuntimeIdentifier)' != 'linux-arm64' And '$(RuntimeIdentifier)' != 'android-arm64' And '$(RuntimeIdentifier)' != 'android-x64' And '@(_AppleRuntime)' == ''"
           Text="Supported RuntimeIdentifiers are win-x64, win-arm64, osx-arm64, linux-x64, linux-arm64, android-arm64, android-x64, ios-arm64, iossimulator-arm64, and maccatalyst-arm64." />
    <Error Condition="'$(NativeLibrariesDirectory)' == '' And '$(NativeLibraryDirectory)' == ''"
           Text="Provide the PLAIN native libraries using NativeLibraryDirectory." />
    <Error Condition="'$(NativeLibrariesDirectory)' == '' And '$(_NativeRuntimeIdentifier)' != 'win-x64' And '$(_NativeRuntimeIdentifier)' != 'win-arm64' And '$(_NativeRuntimeIdentifier)' != 'osx-arm64' And '$(_NativeRuntimeIdentifier)' != 'linux-x64' And '$(_NativeRuntimeIdentifier)' != 'linux-arm64' And '$(_NativeRuntimeIdentifier)' != 'android-arm64' And '$(_NativeRuntimeIdentifier)' != 'android-x64'"
           Text="Local native libraries require win-x64, win-arm64, osx-arm64, linux-x64, linux-arm64, android-arm64, or android-x64." />
    <Error Condition="!Exists('%(RequiredNativeLibrary.Identity)')" Text="Missing native library: %(RequiredNativeLibrary.Identity)" />
  </Target>
</Project>
